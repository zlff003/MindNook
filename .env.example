APP_ENV=development
APP_SECRET=change-this-before-production
DATABASE_URL=mysql+pymysql://mindnook:mindnook-local@127.0.0.1:3307/mindnook
MYSQL_HOST_PORT=3307
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=0.5

SHORT_TERM_MEMORY_PREFIX=mindbridge:short-term-memory
SHORT_TERM_MEMORY_MAX_MESSAGES=40
SHORT_TERM_MEMORY_TTL_SECONDS=86400
MEMORY_RECENT_MESSAGES=8
MEMORY_BRIEF_MAX_CHARS=500
MEMORY_MODEL_HISTORY_MAX_CHARS=6000
# Durable memory: recent count applies only after successful compaction.
MEMORY_ENABLED=true
MEMORY_SUMMARY_MAX_CHARS=400
MEMORY_HISTORY_TOKENS=6000
MEMORY_BATCH_TOKENS=5000
MEMORY_FOREGROUND_MAX_BATCHES=3
MEMORY_MODEL_NAME=
MEMORY_MODEL_TIMEOUT_SECONDS=60
MEMORY_FOREGROUND_MODEL_CALLS=false
MEMORY_BATCH_MAX_MESSAGES=8
MEMORY_BATCH_RETRY_SECONDS=60
MEMORY_BATCH_MAX_ATTEMPTS=3
MEMORY_PREFERENCE_TOKENS=400
MEMORY_RAW_RECALL_TOKENS=1600
MEMORY_CORRECTION_TOKENS=800
MEMORY_RAW_CANDIDATE_LIMIT=300
MEMORY_MODEL_OUTPUT_TOKENS=2048
MEMORY_COLLECTION_NAME=mindnook_user_memories
MEMORY_CANDIDATE_K=8
MEMORY_TOP_K=3
MEMORY_MIN_SIMILARITY=0.45
MEMORY_IDLE_SECONDS=300
MEMORY_WORKER_THREADS=1
MODEL_CONTEXT_TOKENS=16384
MODEL_OUTPUT_TOKENS=1024
MODEL_CONTEXT_MARGIN_TOKENS=512
MODEL_CONTEXT_RESERVE_TOKENS=4096
AGENT_PRIVATE_MEMORY_MAX_ENTRIES=20
AGENT_PRIVATE_MEMORY_TTL_SECONDS=86400

# Local hybrid RAG: Markdown -> 512/64 chunks -> Chroma + BM25 -> reranker.
RAG_KNOWLEDGE_DIR=data/knowledge
RAG_CHROMA_PATH=data/chroma
RAG_COLLECTION_NAME=mindnook_knowledge
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_EMBEDDING_PROVIDER=fastembed
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RAG_EMBEDDING_CACHE_DIR=data/models
RAG_EMBEDDING_DIMENSION=512
RAG_CANDIDATE_K=12
RAG_TOP_K=3
RAG_VECTOR_WEIGHT=0.75
RAG_BM25_WEIGHT=0.25
RAG_RERANKER_ENABLED=true
RAG_RERANKER_PROVIDER=fastembed
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_RERANKER_CACHE_DIR=data/models
RAG_RERANKER_MODEL_WEIGHT=0.5
RAG_RERANKER_TIMEOUT_SECONDS=30
RAG_RERANKER_BATCH_SIZE=12

# mock keeps the MVP fully runnable without external services.
MODEL_PROVIDER=mock
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=
MODEL_NAME=qwen-plus
MODEL_TIMEOUT_SECONDS=20
MODEL_MAX_RETRIES=1
MODEL_MAX_CALLS_PER_RUN=7
MODEL_RUN_TIMEOUT_SECONDS=55
AGENT_MAX_ROUNDS=16
MODEL_JSON_MODE=false

# Optional per-agent model overrides; empty means MODEL_NAME.
MODEL_UNDERSTANDING_NAME=
MODEL_SAFETY_NAME=
MODEL_RESPONSE_NAME=

# Durable asynchronous tool queue.
TOOL_WORKER_POLL_SECONDS=1
TOOL_WORKER_BATCH_SIZE=20
TOOL_WORKER_MAX_ATTEMPTS=3
TOOL_WORKER_RETRY_BASE_SECONDS=2
TOOL_WORKER_RUNNING_TIMEOUT_SECONDS=300
TOOL_WORKER_CASE_WORKERS=2
TOOL_WORKER_ALERT_WORKERS=2
ALERT_RATE_LIMIT_PER_MINUTE=10

# Optional SMTP delivery. Empty values keep the local log-only alert mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
ALERT_EMAIL_TO=
SMTP_USE_TLS=true

# Local-only demo accounts. Replace or disable before deployment.
DEMO_STUDENT_USERNAME=student
DEMO_STUDENT_PASSWORD=student123
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin123
