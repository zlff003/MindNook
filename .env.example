APP_ENV=development
APP_SECRET=change-this-before-production
DATABASE_URL=mysql+pymysql://mindnook:mindnook-local@127.0.0.1:3307/mindnook
MYSQL_HOST_PORT=3307
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=0.5

SHORT_TERM_MEMORY_PREFIX=mindbridge:short-term-memory
SHORT_TERM_MEMORY_MAX_MESSAGES=40
SHORT_TERM_MEMORY_TTL_SECONDS=86400
MEMORY_RECENT_MESSAGES=8
MEMORY_BRIEF_MAX_CHARS=500
MEMORY_MODEL_HISTORY_MAX_CHARS=6000
AGENT_PRIVATE_MEMORY_MAX_ENTRIES=20
AGENT_PRIVATE_MEMORY_TTL_SECONDS=86400

# Local hybrid RAG: Markdown -> 512/64 chunks -> Chroma + BM25 -> reranker.
RAG_KNOWLEDGE_DIR=data/knowledge
RAG_CHROMA_PATH=data/chroma
RAG_COLLECTION_NAME=mindnook_knowledge
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_EMBEDDING_DIMENSION=384
RAG_CANDIDATE_K=12
RAG_TOP_K=3
RAG_VECTOR_WEIGHT=0.45
RAG_BM25_WEIGHT=0.55

# mock keeps the MVP fully runnable without external services.
MODEL_PROVIDER=mock
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=
MODEL_NAME=qwen-plus
MODEL_TIMEOUT_SECONDS=20
MODEL_MAX_RETRIES=1
MODEL_MAX_CALLS_PER_RUN=7
MODEL_RUN_TIMEOUT_SECONDS=55
AGENT_MAX_ROUNDS=16
MODEL_JSON_MODE=false

# Optional per-agent model overrides; empty means MODEL_NAME.
MODEL_UNDERSTANDING_NAME=
MODEL_SAFETY_NAME=
MODEL_RESPONSE_NAME=

# Derived Excel ledger written by the asynchronous ledger tool.
EXCEL_LEDGER_PATH=data/exports/mindnook-risk-ledger.xlsx

# Durable asynchronous tool queue.
TOOL_WORKER_POLL_SECONDS=1
TOOL_WORKER_BATCH_SIZE=20
TOOL_WORKER_MAX_ATTEMPTS=3
TOOL_WORKER_RETRY_BASE_SECONDS=2
TOOL_WORKER_RUNNING_TIMEOUT_SECONDS=300
TOOL_WORKER_EXCEL_WORKERS=1
TOOL_WORKER_CASE_WORKERS=2
TOOL_WORKER_ALERT_WORKERS=2
ALERT_RATE_LIMIT_PER_MINUTE=10

# Optional SMTP delivery. Empty values keep the local log-only alert mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
ALERT_EMAIL_TO=
SMTP_USE_TLS=true

# Local-only demo accounts. Replace or disable before deployment.
DEMO_STUDENT_USERNAME=student
DEMO_STUDENT_PASSWORD=student123
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin123
